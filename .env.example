# Campus Performance Portal - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local customization.

# Override SQLite database path (default: data/student_performance.db)
# STUDENT_DB_PATH=data/student_performance.db

# Optional Streamlit server port configuration
# STREAMLIT_SERVER_PORT=8501

# Application environment mode (development / production)
# APP_ENV=development
